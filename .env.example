# O endereço do Ahreas da sua administradora.
AHREAS_BASE_URL=https://sistema.suaadministradora.com.br

# Credencial de web service (usuário, senha e a chave de acesso da integração).
# As três entram por aqui e nunca são parâmetro de tool.
AHREAS_USUARIO=
AHREAS_SENHA=
AHREAS_CHAVE=

# Tempo máximo por chamada e quantas tentativas num soluço de rede.
AHREAS_TIMEOUT_SEGUNDOS=30
AHREAS_TENTATIVAS=2

# Validade do cache do catálogo lido do WSDL.
AHREAS_CACHE_WSDL_SEGUNDOS=3600

# Libera operações de escrita (lançar contábil, aprovar pagamento, emitir
# recibo...). Desligado por padrão.
AHREAS_PERMITIR_ESCRITA=false
