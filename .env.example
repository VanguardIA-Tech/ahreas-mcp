# O endereço do Ahreas da sua administradora.
AHREAS_BASE_URL=https://sistema.suaadministradora.com.br

# A chave de acesso do web service: o passe da administradora para a integração.
# Fica sempre no servidor e vale para todas as sessões.
AHREAS_CHAVE=

# Identidade do modo LOCAL (stdio), para uso pessoal. No modo remoto (HTTP +
# OAuth) cada pessoa entra com o usuário e senha dela na tela de login, e estes
# ficam vazios. Nunca são parâmetro de tool.
AHREAS_USUARIO=
AHREAS_SENHA=

# --- Modo remoto (HTTP + OAuth, multiusuário) ---------------------------------
# A URL pública por onde os clientes MCP chegam (Claude, GPT, Cursor). É a âncora
# do OAuth. Sem ela, o servidor só serve stdio local.
AHREAS_PUBLIC_URL=
# Quanto tempo a sessão do navegador vale antes de exigir novo login.
AHREAS_SESSAO_HORAS=12

# Tempo máximo por chamada e quantas tentativas num soluço de rede.
AHREAS_TIMEOUT_SEGUNDOS=30
AHREAS_TENTATIVAS=2

# Validade do cache do catálogo lido do WSDL.
AHREAS_CACHE_WSDL_SEGUNDOS=3600

# Libera operações de escrita (lançar contábil, aprovar pagamento, emitir
# recibo...). Desligado por padrão.
AHREAS_PERMITIR_ESCRITA=false
